---
import * as stylex from "@stylexjs/stylex";

import { styles } from "../styles/top-artists.stylex";
---

<div
  {...stylex.attrs(styles.root)}
  data-top-artists
  data-artist-item-class={stylex.attrs(styles.artistItem).class}
  data-artist-name-class={stylex.attrs(styles.artistName).class}
  data-artist-count-class={stylex.attrs(styles.artistCount).class}
>
  <div {...stylex.attrs(styles.header)}>
    <h3 {...stylex.attrs(styles.title)}><span>top artists</span></h3>
    <div {...stylex.attrs(styles.dropdown)} data-period-dropdown>
      <button
        {...stylex.attrs(styles.trigger)}
        type="button"
        aria-expanded="false"
        aria-controls="top-artist-periods"
        data-period-trigger
      >
        <span data-period-label>180 days</span>
      </button>
      <div
        {...stylex.attrs(styles.viewport)}
        data-period-menu-viewport
        data-open="false"
      >
        <div
          {...stylex.attrs(styles.menu)}
          id="top-artist-periods"
          aria-label="Time period"
          data-period-menu
          data-open="false"
        >
          {
            [30, 90, 180].map((days) => (
              <button
                {...stylex.attrs(styles.option)}
                type="button"
                data-period={days}
                aria-current={days === 180 ? "true" : undefined}
              >
                {days} days
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div
    {...stylex.attrs(styles.content)}
    data-artists-content
    data-changing="false"
  >
    <ol
      {...stylex.attrs(styles.list)}
      aria-live="polite"
      aria-busy="true"
      data-artist-list
    >
    </ol>
    <p {...stylex.attrs(styles.status)} role="status" data-artist-status>
      loading…
    </p>
  </div>
</div>

<script>
  interface Artist {
    name: string;
    playcount: number;
    url: string;
  }

  document
    .querySelectorAll<HTMLElement>("[data-top-artists]")
    .forEach((root) => {
      const list = root.querySelector<HTMLOListElement>("[data-artist-list]");
      const status = root.querySelector<HTMLElement>("[data-artist-status]");
      const dropdown = root.querySelector<HTMLElement>(
        "[data-period-dropdown]",
      );
      const trigger = root.querySelector<HTMLButtonElement>(
        "[data-period-trigger]",
      );
      const periodLabel = root.querySelector<HTMLElement>(
        "[data-period-label]",
      );
      const content = root.querySelector<HTMLElement>("[data-artists-content]");
      const viewport = root.querySelector<HTMLElement>(
        "[data-period-menu-viewport]",
      );
      const menu = root.querySelector<HTMLElement>("[data-period-menu]");
      const buttons = root.querySelectorAll<HTMLButtonElement>("[data-period]");
      const artistClasses = {
        item: root.dataset.artistItemClass ?? "",
        name: root.dataset.artistNameClass ?? "",
        count: root.dataset.artistCountClass ?? "",
      };
      const loaded = new Map<string, Artist[]>();
      const transitionDuration = matchMedia("(prefers-reduced-motion: reduce)")
        .matches
        ? 0
        : 180;
      let requestId = 0;

      function setDropdownOpen(open: boolean) {
        if (!dropdown || !trigger) return;
        dropdown.dataset.open = String(open);
        if (viewport) viewport.dataset.open = String(open);
        if (menu) menu.dataset.open = String(open);
        trigger.setAttribute("aria-expanded", String(open));
      }

      function render(artists: Artist[]) {
        if (!list || !status) return;
        list.replaceChildren(
          ...artists.map((artist) => {
            const item = document.createElement("li");
            const link = document.createElement("a");
            const count = document.createElement("span");
            // StyleX can combine several atomic classes, so assign the full
            // generated string instead of passing it to classList.add().
            item.className = artistClasses.item;
            link.className = artistClasses.name;
            count.className = artistClasses.count;
            link.href = artist.url;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.textContent = artist.name;
            count.textContent = `${artist.playcount.toLocaleString()} plays`;
            item.appendChild(link);
            item.appendChild(count);
            return item;
          }),
        );
        status.hidden = true;
        list.setAttribute("aria-busy", "false");
      }

      async function fadeOutContent() {
        if (!content || transitionDuration === 0) return;
        content.dataset.changing = "true";
        await new Promise((resolve) => setTimeout(resolve, transitionDuration));
      }

      function fadeInContent() {
        if (content) content.dataset.changing = "false";
      }

      async function selectPeriod(period: string) {
        const currentRequest = ++requestId;
        buttons.forEach((button) => {
          if (button.dataset.period === period) {
            button.setAttribute("aria-current", "true");
          } else {
            button.removeAttribute("aria-current");
          }
        });
        if (periodLabel) periodLabel.textContent = `${period} days`;
        setDropdownOpen(false);

        await fadeOutContent();
        if (currentRequest !== requestId) return;

        const cached = loaded.get(period);
        if (cached) {
          render(cached);
          fadeInContent();
          return;
        }

        if (list && status) {
          list.replaceChildren();
          list.setAttribute("aria-busy", "true");
          status.textContent = "loading…";
          status.hidden = false;
        }
        fadeInContent();

        try {
          const response = await fetch(`/api/top-artists?period=${period}`);
          if (!response.ok) throw new Error("Unable to load top artists");
          const data = (await response.json()) as { artists?: Artist[] };
          if (!Array.isArray(data.artists)) throw new Error("Invalid response");
          loaded.set(period, data.artists);
          if (currentRequest !== requestId) return;
          await fadeOutContent();
          if (currentRequest !== requestId) return;
          render(data.artists);
          fadeInContent();
        } catch {
          if (currentRequest !== requestId || !list || !status) return;
          await fadeOutContent();
          if (currentRequest !== requestId) return;
          list.replaceChildren();
          list.setAttribute("aria-busy", "false");
          status.textContent = "top artists unavailable";
          status.hidden = false;
          fadeInContent();
        }
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          if (button.dataset.period) void selectPeriod(button.dataset.period);
        });
      });

      trigger?.addEventListener("click", () => {
        setDropdownOpen(trigger.getAttribute("aria-expanded") !== "true");
      });

      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !dropdown?.contains(event.target)) {
          setDropdownOpen(false);
        }
      });

      dropdown?.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        setDropdownOpen(false);
        trigger?.focus();
      });

      void selectPeriod("180");
    });
</script>
