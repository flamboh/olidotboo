---
const dropdowns = [
  {
    name: "count",
    lead: "top",
    label: "Number of artists",
    selected: "4",
    options: [4, 8].map((count) => ({
      value: String(count),
      text: `${count} artists`,
    })),
  },
  {
    name: "period",
    lead: "in the last",
    label: "Time period",
    selected: "180",
    options: [30, 90, 180].map((days) => ({
      value: String(days),
      text: `${days} days`,
    })),
  },
];
---

<div class="top-artists" data-top-artists>
  <div class="top-artists-header" role="heading" aria-level="3">
    {
      dropdowns.map((dropdown) => (
        <>
          <span class="label top-artists-text">{dropdown.lead}</span>
          <div
            class="dropdown"
            style={`--dropdown-width: ${Math.max(...dropdown.options.map((option) => option.text.length))}ch`}
            data-dropdown={dropdown.name}
          >
            <button
              class="dropdown-trigger"
              type="button"
              aria-expanded="false"
              aria-controls={`top-artist-${dropdown.name}`}
              data-dropdown-trigger
            >
              <span data-dropdown-label>
                {
                  dropdown.options.find(
                    (option) => option.value === dropdown.selected,
                  )?.text
                }
              </span>
            </button>
            <div class="dropdown-menu-viewport">
              <div
                class="dropdown-menu"
                id={`top-artist-${dropdown.name}`}
                aria-label={dropdown.label}
              >
                {dropdown.options.map((option) => (
                  <button
                    type="button"
                    data-value={option.value}
                    aria-current={
                      option.value === dropdown.selected ? "true" : undefined
                    }
                  >
                    {option.text}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </>
      ))
    }
    <span class="label top-artists-rule"></span>
  </div>

  <div class="artists-content">
    <ol aria-live="polite" aria-busy="true" data-artist-list>
      {
        Array.from({ length: 4 }, () => (
          <li class="artist-item artist-placeholder" aria-hidden="true">
            <span class="artist-name">&nbsp;</span>
            <span class="artist-count">
              <span class="artist-playcount">0</span>
              <span class="artist-plays"> plays</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="artist-status" role="status" data-artist-status>loading…</p>
  </div>
</div>

<script>
  import { cascadeDelays } from "@/lib/cascade";

  interface Artist {
    name: string;
    playcount: number;
    url: string;
  }

  document
    .querySelectorAll<HTMLElement>("[data-top-artists]")
    .forEach((root) => {
      const list = root.querySelector<HTMLOListElement>("[data-artist-list]");
      const status = root.querySelector<HTMLElement>("[data-artist-status]");
      const content = root.querySelector<HTMLElement>(".artists-content");
      const periodOptions = root.querySelectorAll<HTMLButtonElement>(
        '[data-dropdown="period"] [data-value]',
      );
      const requests = new Map<string, Promise<Artist[]>>();
      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const fadeDuration = 220;
      const moveDuration = 520;
      const moveEasing = "cubic-bezier(0.65, 0, 0.35, 1)";
      const cascadeStep = moveDuration * 0.4;
      let requestId = 0;
      let period = "180";
      let count = 4;

      function setupDropdown(
        dropdown: HTMLElement,
        onSelect: (value: string) => void,
      ) {
        const trigger = dropdown.querySelector<HTMLButtonElement>(
          "[data-dropdown-trigger]",
        );
        const label = dropdown.querySelector<HTMLElement>(
          "[data-dropdown-label]",
        );
        const options =
          dropdown.querySelectorAll<HTMLButtonElement>("[data-value]");

        function setOpen(open: boolean) {
          dropdown.dataset.open = String(open);
          trigger?.setAttribute("aria-expanded", String(open));
        }

        options.forEach((option) => {
          option.addEventListener("click", () => {
            options.forEach((other) => {
              if (other === option) {
                other.setAttribute("aria-current", "true");
              } else {
                other.removeAttribute("aria-current");
              }
            });
            if (label) label.textContent = option.textContent?.trim() ?? "";
            setOpen(false);
            if (option.dataset.value) onSelect(option.dataset.value);
          });
        });

        trigger?.addEventListener("click", () => {
          setOpen(trigger.getAttribute("aria-expanded") !== "true");
        });

        document.addEventListener("click", (event) => {
          if (
            event.target instanceof Node &&
            !dropdown.contains(event.target)
          ) {
            setOpen(false);
          }
        });

        dropdown.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          setOpen(false);
          trigger?.focus();
        });
      }

      function loadArtists(period: string) {
        let request = requests.get(period);
        if (!request) {
          request = fetch(`/api/top-artists?period=${period}&limit=8`)
            .then(async (response) => {
              if (!response.ok) throw new Error("Unable to load top artists");
              const data = (await response.json()) as { artists?: Artist[] };
              if (!Array.isArray(data.artists)) {
                throw new Error("Invalid response");
              }
              return data.artists;
            })
            .catch((error: unknown) => {
              requests.delete(period);
              throw error;
            });
          requests.set(period, request);
        }
        return request;
      }

      function prefetchOtherPeriods(period: string) {
        periodOptions.forEach((option) => {
          const other = option.dataset.value;
          if (other && other !== period) loadArtists(other).catch(() => {});
        });
      }

      function createItem(artist: Artist) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        const count = document.createElement("span");
        const playcount = document.createElement("span");
        const label = document.createElement("span");
        item.className = "artist-item";
        item.dataset.artist = artist.name;
        link.className = "artist-name";
        count.className = "artist-count";
        playcount.className = "artist-playcount";
        label.className = "artist-plays";
        playcount.textContent = artist.playcount.toLocaleString();
        shownCounts.set(item, artist.playcount);
        label.textContent = " plays";
        link.href = artist.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = artist.name;
        count.appendChild(playcount);
        count.appendChild(label);
        item.appendChild(link);
        item.appendChild(count);
        return item;
      }

      function currentItems() {
        return new Map(
          [
            ...(list?.querySelectorAll<HTMLLIElement>(".artist-item") ?? []),
          ].flatMap((item) =>
            item.dataset.artist ? [[item.dataset.artist, item] as const] : [],
          ),
        );
      }

      async function finished(animations: Animation[]) {
        await Promise.all(
          animations.map((animation) => animation.finished.catch(() => {})),
        );
      }

      function fadeOut(elements: Element[]) {
        return finished(
          elements.map((element) =>
            element.animate(
              [{ opacity: getComputedStyle(element).opacity }, { opacity: 0 }],
              { duration: fadeDuration, easing: "ease", fill: "forwards" },
            ),
          ),
        );
      }

      function playcountOf(item: Element) {
        return item.querySelector(".artist-playcount")!;
      }

      function labelOf(item: Element) {
        return item.querySelector(".artist-plays")!;
      }

      function labelOffset(item: Element) {
        return (
          labelOf(item).getBoundingClientRect().left -
          item.getBoundingClientRect().left
        );
      }

      function fadeIn(element: Element, from: number, delay: number) {
        if (from < 1) {
          element.animate([{ opacity: from }, { opacity: 1 }], {
            duration: moveDuration,
            delay,
            easing: "ease",
            fill: "backwards",
          });
        }
      }

      const shownCounts = new WeakMap<Element, number>();
      const countFrames = new WeakMap<Element, number>();

      function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
      }

      function stopCount(item: Element) {
        const frame = countFrames.get(item);
        if (frame !== undefined) cancelAnimationFrame(frame);
        countFrames.delete(item);
      }

      function setPlaycount(item: Element, value: number) {
        const playcount = playcountOf(item);
        const text = value.toLocaleString();
        if (playcount.textContent === text) return;
        const widthChanged = playcount.textContent?.length !== text.length;
        const labelBefore = widthChanged ? labelOffset(item) : 0;
        playcount.textContent = text;
        shownCounts.set(item, value);
        if (!widthChanged || reducedMotion) return;
        const labelDx = labelBefore - labelOffset(item);
        if (labelDx !== 0) {
          labelOf(item).animate(
            [{ transform: `translateX(${labelDx}px)` }, { transform: "none" }],
            { duration: moveDuration / 3, easing: "ease-out" },
          );
        }
      }

      function countTo(item: Element, target: number, delay: number) {
        stopCount(item);
        const from = shownCounts.get(item) ?? target;
        if (from === target) {
          setPlaycount(item, target);
          return;
        }
        const startTime = performance.now() + delay;
        const tick = (now: number) => {
          const progress = Math.min(
            Math.max((now - startTime) / moveDuration, 0),
            1,
          );
          setPlaycount(
            item,
            Math.round(from + (target - from) * easeInOutCubic(progress)),
          );
          if (progress < 1) {
            countFrames.set(item, requestAnimationFrame(tick));
          } else {
            countFrames.delete(item);
          }
        };
        countFrames.set(item, requestAnimationFrame(tick));
      }

      function pinLeaving(
        item: HTMLElement,
        rect: DOMRect,
        opacity: string,
        listRect: DOMRect,
      ) {
        stopCount(item);
        item
          .getAnimations({ subtree: true })
          .forEach((animation) => animation.cancel());
        delete item.dataset.artist;
        item.classList.add("artist-leaving");
        item.style.top = `${rect.top - listRect.top}px`;
        item.style.left = `${rect.left - listRect.left}px`;
        item.style.width = `${rect.width}px`;
        item
          .animate([{ opacity }, { opacity: 0 }], {
            duration: fadeDuration,
            easing: "ease",
            fill: "forwards",
          })
          .finished.then(() => item.remove())
          .catch(() => {});
      }

      function showArtists(artists: Artist[]) {
        if (!list || !status) return;
        const existing = currentItems();
        const nextNames = new Set(artists.map((artist) => artist.name));
        const leaving = [...existing]
          .filter(([name]) => !nextNames.has(name))
          .map(([, item]) => item);
        const ghosts = [
          ...list.querySelectorAll<HTMLElement>(".artist-leaving"),
        ];
        const start = leaving.length > 0 ? fadeDuration : 0;

        const listRect = list.getBoundingClientRect();
        const leavingState = leaving.map((item) => ({
          item,
          rect: item.getBoundingClientRect(),
          opacity: getComputedStyle(item).opacity,
        }));

        const first = new Map<
          Element,
          {
            rect: DOMRect;
            opacity: number;
            labelOffset: number;
          }
        >();
        const startHeight = content?.getBoundingClientRect().height ?? 0;
        if (content && !reducedMotion) {
          content.style.height = `${startHeight}px`;
        }
        content?.getAnimations().forEach((animation) => animation.cancel());
        existing.forEach((item) => {
          if (leaving.includes(item)) return;
          first.set(item, {
            rect: item.getBoundingClientRect(),
            opacity: Number(getComputedStyle(item).opacity),
            labelOffset: labelOffset(item),
          });
          stopCount(item);
          item
            .getAnimations({ subtree: true })
            .forEach((animation) => animation.cancel());
        });

        if (!reducedMotion) {
          leavingState.forEach(({ item, rect, opacity }) =>
            pinLeaving(item, rect, opacity, listRect),
          );
        }

        const items = artists.map(
          (artist) => existing.get(artist.name) ?? createItem(artist),
        );
        list.replaceChildren(
          ...items,
          ...(reducedMotion ? [] : [...ghosts, ...leaving]),
        );
        status.hidden = true;
        list.setAttribute("aria-busy", "false");
        if (reducedMotion) {
          items.forEach((item, index) => {
            stopCount(item);
            setPlaycount(item, artists[index].playcount);
          });
          return;
        }

        if (content) {
          const endHeight = Math.max(
            list.getBoundingClientRect().height,
            parseFloat(getComputedStyle(content).minHeight),
          );
          if (existing.size > 0 && startHeight !== endHeight) {
            content.animate(
              [
                { height: `${startHeight}px`, overflow: "clip" },
                { height: `${endHeight}px`, overflow: "clip" },
              ],
              { duration: moveDuration, easing: moveEasing },
            );
          }
          content.style.height = "";
        }

        const delays = cascadeDelays(
          [...existing.keys()],
          artists.map((artist) => artist.name),
          cascadeStep,
        );
        items.forEach((item, index) => {
          const delay = start + (delays.get(artists[index].name) ?? 0);
          const before = first.get(item);
          if (!before) {
            fadeIn(item, 0, delay);
            return;
          }
          const after = item.getBoundingClientRect();
          const labelDx = before.labelOffset - labelOffset(item);
          const dx = before.rect.left - after.left;
          const dy = before.rect.top - after.top;
          if (dx !== 0 || dy !== 0) {
            item.animate(
              [
                { transform: `translate(${dx}px, ${dy}px)` },
                { transform: "none" },
              ],
              {
                duration: moveDuration,
                delay,
                easing: moveEasing,
                fill: "backwards",
              },
            );
          }
          if (labelDx !== 0) {
            labelOf(item).animate(
              [
                { transform: `translateX(${labelDx}px)` },
                { transform: "none" },
              ],
              { duration: moveDuration / 2, easing: "ease-out" },
            );
          }
          fadeIn(item, before.opacity, delay);
          countTo(item, artists[index].playcount, delay);
        });
      }

      async function showError(currentRequest: number) {
        if (!list || !status) return;
        if (!reducedMotion) {
          await fadeOut([...currentItems().values()]);
          if (currentRequest !== requestId) return;
        }
        list.replaceChildren();
        list.setAttribute("aria-busy", "false");
        status.textContent = "top artists unavailable";
        status.hidden = false;
        if (!reducedMotion) {
          status.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: fadeDuration,
            easing: "ease",
          });
        }
      }

      async function update() {
        const currentRequest = ++requestId;
        list?.setAttribute("aria-busy", "true");

        try {
          const artists = await loadArtists(period);
          if (currentRequest !== requestId) return;
          showArtists(artists.slice(0, count));
          prefetchOtherPeriods(period);
        } catch {
          if (currentRequest !== requestId) return;
          await showError(currentRequest);
        }
      }

      root
        .querySelectorAll<HTMLElement>("[data-dropdown]")
        .forEach((dropdown) => {
          setupDropdown(dropdown, (value) => {
            if (dropdown.dataset.dropdown === "count") {
              count = Number(value);
            } else {
              period = value;
            }
            void update();
          });
        });

      void update();
    });
</script>

<style>
  .top-artists {
    margin-top: 1.25rem;
  }

  /* Bottom-aligned so the trigger's own border picks up exactly where the
     label's rule leaves off, reading as one line across the row. */
  .top-artists-header {
    display: flex;
    align-items: flex-end;
  }

  .top-artists-text {
    padding-inline: 0.5em;
  }

  .top-artists-text:first-child {
    padding-left: 0;
  }

  .top-artists-rule {
    flex: 1;
  }

  .dropdown {
    position: relative;
    width: calc(var(--dropdown-width) + 0.625rem);
    font-size: 0.75rem;
  }

  .dropdown-trigger {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 0.3125rem 0.125rem;
    background: var(--bg);
    border-bottom: 1px solid var(--fg-tertiary);
    transition:
      color var(--theme-fade) ease,
      background-color var(--theme-fade) ease,
      border-color var(--theme-fade) ease;
  }

  [data-dropdown-label] {
    position: relative;
    top: -0.21625rem;
  }

  .dropdown-menu-viewport {
    position: absolute;
    z-index: 2;
    top: calc(100% - 1px);
    right: -1px;
    width: calc(100% + 2px);
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 0.34s;
  }

  .dropdown-menu {
    background: var(--bg);
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 4px 4px;
    transform: translateY(-100%);
    transition:
      transform 0.34s cubic-bezier(0.22, 0.8, 0.25, 1),
      background-color var(--theme-fade) ease,
      border-color var(--theme-fade) ease;
  }

  .dropdown[data-open="true"] .dropdown-menu-viewport {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .dropdown[data-open="true"] .dropdown-menu {
    transform: translateY(0);
  }

  .dropdown-menu button {
    display: block;
    width: 100%;
    padding: 0.25rem;
    text-align: left;
    white-space: nowrap;
    border-radius: 2px;
    transition:
      color var(--theme-fade) ease,
      background-color var(--theme-fade) ease;
  }

  .dropdown-menu button:hover {
    background: var(--border);
  }

  .dropdown-menu button[aria-current="true"] {
    color: var(--fg);
  }

  .artists-content {
    display: grid;
    min-height: 6.5rem;
    margin-top: 0.625rem;
  }

  ol {
    position: relative;
    grid-area: 1 / 1;
    align-self: start;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: 0.875rem 2rem;
    list-style: none;
  }

  .top-artists :global(.artist-item) {
    min-width: 0;
  }

  .top-artists :global(.artist-leaving) {
    position: absolute;
    pointer-events: none;
  }

  .artist-placeholder {
    visibility: hidden;
  }

  .top-artists :global(.artist-name),
  .top-artists :global(.artist-count) {
    display: block;
  }

  .top-artists :global(.artist-count) {
    margin-top: 0.125rem;
    color: var(--fg-tertiary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .top-artists :global(.artist-plays) {
    display: inline-block;
    white-space: pre;
  }

  .artist-status {
    grid-area: 1 / 1;
    place-self: center;
    color: var(--fg-tertiary);
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-menu {
      transition: none;
    }
  }
</style>
