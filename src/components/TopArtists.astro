<div class="top-artists" data-top-artists>
  <div class="top-artists-header">
    <h3 class="label top-artists-title"><span>top artists</span></h3>
    <div class="period-dropdown" data-period-dropdown>
      <button
        class="period-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="top-artist-periods"
        data-period-trigger
      >
        <span data-period-label>180 days</span>
      </button>
      <div class="period-menu-viewport">
        <div
          class="period-menu"
          id="top-artist-periods"
          aria-label="Time period"
        >
          {
            [30, 90, 180].map((days) => (
              <button
                type="button"
                data-period={days}
                aria-current={days === 180 ? "true" : undefined}
              >
                {days} days
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="artists-content">
    <ol aria-live="polite" aria-busy="true" data-artist-list></ol>
    <p class="artist-status" role="status" data-artist-status>loading…</p>
  </div>
</div>

<script>
  import { cascadeDelays } from "@/lib/cascade";

  interface Artist {
    name: string;
    playcount: number;
    url: string;
  }

  document
    .querySelectorAll<HTMLElement>("[data-top-artists]")
    .forEach((root) => {
      const list = root.querySelector<HTMLOListElement>("[data-artist-list]");
      const status = root.querySelector<HTMLElement>("[data-artist-status]");
      const dropdown = root.querySelector<HTMLElement>(
        "[data-period-dropdown]",
      );
      const trigger = root.querySelector<HTMLButtonElement>(
        "[data-period-trigger]",
      );
      const periodLabel = root.querySelector<HTMLElement>(
        "[data-period-label]",
      );
      const buttons = root.querySelectorAll<HTMLButtonElement>("[data-period]");
      const requests = new Map<string, Promise<Artist[]>>();
      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const fadeDuration = 180;
      const moveDuration = 420;
      const moveEasing = "cubic-bezier(0.22, 0.8, 0.25, 1)";
      const cascadeStep = moveDuration / 2;
      let requestId = 0;

      function setDropdownOpen(open: boolean) {
        if (!dropdown || !trigger) return;
        dropdown.dataset.open = String(open);
        trigger.setAttribute("aria-expanded", String(open));
      }

      function loadArtists(period: string) {
        let request = requests.get(period);
        if (!request) {
          request = fetch(`/api/top-artists?period=${period}`)
            .then(async (response) => {
              if (!response.ok) throw new Error("Unable to load top artists");
              const data = (await response.json()) as { artists?: Artist[] };
              if (!Array.isArray(data.artists)) {
                throw new Error("Invalid response");
              }
              return data.artists;
            })
            .catch((error: unknown) => {
              requests.delete(period);
              throw error;
            });
          requests.set(period, request);
        }
        return request;
      }

      function prefetchOtherPeriods(period: string) {
        buttons.forEach((button) => {
          const other = button.dataset.period;
          if (other && other !== period) loadArtists(other).catch(() => {});
        });
      }

      function createItem(artist: Artist) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        const count = document.createElement("span");
        const playcount = document.createElement("span");
        const label = document.createElement("span");
        item.className = "artist-item";
        item.dataset.artist = artist.name;
        link.className = "artist-name";
        count.className = "artist-count";
        playcount.className = "artist-playcount";
        label.className = "artist-plays";
        label.textContent = " plays";
        link.href = artist.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = artist.name;
        count.appendChild(playcount);
        count.appendChild(label);
        item.appendChild(link);
        item.appendChild(count);
        return item;
      }

      function currentItems() {
        return new Map(
          [
            ...(list?.querySelectorAll<HTMLLIElement>(".artist-item") ?? []),
          ].flatMap((item) =>
            item.dataset.artist ? [[item.dataset.artist, item] as const] : [],
          ),
        );
      }

      async function finished(animations: Animation[]) {
        await Promise.all(
          animations.map((animation) => animation.finished.catch(() => {})),
        );
      }

      function fadeOut(elements: Element[]) {
        return finished(
          elements.map((element) =>
            element.animate(
              [{ opacity: getComputedStyle(element).opacity }, { opacity: 0 }],
              { duration: fadeDuration, easing: "ease", fill: "forwards" },
            ),
          ),
        );
      }

      function playcountOf(item: Element) {
        return item.querySelector(".artist-playcount")!;
      }

      function labelOf(item: Element) {
        return item.querySelector(".artist-plays")!;
      }

      function labelOffset(item: Element) {
        return (
          labelOf(item).getBoundingClientRect().left -
          item.getBoundingClientRect().left
        );
      }

      function fadeIn(element: Element, from: number, delay: number) {
        if (from < 1) {
          element.animate([{ opacity: from }, { opacity: 1 }], {
            duration: moveDuration,
            delay,
            easing: "ease",
            fill: "backwards",
          });
        }
      }

      async function showArtists(artists: Artist[], currentRequest: number) {
        if (!list || !status) return;
        const existing = currentItems();
        const nextNames = new Set(artists.map((artist) => artist.name));
        const leaving = [...existing]
          .filter(([name]) => !nextNames.has(name))
          .map(([, item]) => item);
        const changedPlaycounts = artists.flatMap((artist) => {
          const item = existing.get(artist.name);
          return item &&
            playcountOf(item).textContent !== artist.playcount.toLocaleString()
            ? [playcountOf(item)]
            : [];
        });

        if (!reducedMotion && leaving.length + changedPlaycounts.length > 0) {
          await fadeOut([...leaving, ...changedPlaycounts]);
          if (currentRequest !== requestId) return;
        }

        const first = new Map<
          Element,
          {
            rect: DOMRect;
            opacity: number;
            playcountOpacity: number;
            labelOffset: number;
          }
        >();
        existing.forEach((item) => {
          first.set(item, {
            rect: item.getBoundingClientRect(),
            opacity: Number(getComputedStyle(item).opacity),
            playcountOpacity: Number(
              getComputedStyle(playcountOf(item)).opacity,
            ),
            labelOffset: labelOffset(item),
          });
          item
            .getAnimations({ subtree: true })
            .forEach((animation) => animation.cancel());
        });

        const items = artists.map((artist) => {
          const item = existing.get(artist.name) ?? createItem(artist);
          playcountOf(item).textContent = artist.playcount.toLocaleString();
          return item;
        });
        list.replaceChildren(...items);
        status.hidden = true;
        list.setAttribute("aria-busy", "false");
        if (reducedMotion) return;

        const delays = cascadeDelays(
          [...existing.keys()],
          artists.map((artist) => artist.name),
          cascadeStep,
        );
        items.forEach((item, index) => {
          const delay = delays.get(artists[index].name) ?? 0;
          const before = first.get(item);
          if (!before) {
            fadeIn(item, 0, delay);
            return;
          }
          const after = item.getBoundingClientRect();
          const labelDx = before.labelOffset - labelOffset(item);
          const dx = before.rect.left - after.left;
          const dy = before.rect.top - after.top;
          if (dx !== 0 || dy !== 0) {
            item.animate(
              [
                { transform: `translate(${dx}px, ${dy}px)` },
                { transform: "none" },
              ],
              {
                duration: moveDuration,
                delay,
                easing: moveEasing,
                fill: "backwards",
              },
            );
          }
          if (labelDx !== 0) {
            labelOf(item).animate(
              [
                { transform: `translateX(${labelDx}px)` },
                { transform: "none" },
              ],
              {
                duration: moveDuration,
                delay,
                easing: moveEasing,
                fill: "backwards",
              },
            );
          }
          fadeIn(item, before.opacity, delay);
          fadeIn(playcountOf(item), before.playcountOpacity, delay);
        });
      }

      async function showError(currentRequest: number) {
        if (!list || !status) return;
        if (!reducedMotion) {
          await fadeOut([...currentItems().values()]);
          if (currentRequest !== requestId) return;
        }
        list.replaceChildren();
        list.setAttribute("aria-busy", "false");
        status.textContent = "top artists unavailable";
        status.hidden = false;
        if (!reducedMotion) {
          status.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: fadeDuration,
            easing: "ease",
          });
        }
      }

      async function selectPeriod(period: string) {
        const currentRequest = ++requestId;
        buttons.forEach((button) => {
          if (button.dataset.period === period) {
            button.setAttribute("aria-current", "true");
          } else {
            button.removeAttribute("aria-current");
          }
        });
        if (periodLabel) periodLabel.textContent = `${period} days`;
        setDropdownOpen(false);
        list?.setAttribute("aria-busy", "true");

        try {
          const artists = await loadArtists(period);
          if (currentRequest !== requestId) return;
          await showArtists(artists, currentRequest);
          prefetchOtherPeriods(period);
        } catch {
          if (currentRequest !== requestId) return;
          await showError(currentRequest);
        }
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          if (button.dataset.period) void selectPeriod(button.dataset.period);
        });
      });

      trigger?.addEventListener("click", () => {
        setDropdownOpen(trigger.getAttribute("aria-expanded") !== "true");
      });

      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !dropdown?.contains(event.target)) {
          setDropdownOpen(false);
        }
      });

      dropdown?.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        setDropdownOpen(false);
        trigger?.focus();
      });

      void selectPeriod("180");
    });
</script>

<style>
  .top-artists {
    margin-top: 1.25rem;
  }

  /* Bottom-aligned so the trigger's own border picks up exactly where the
     label's rule leaves off, reading as one line across the row. */
  .top-artists-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .top-artists-title {
    flex: 1;
  }

  .period-dropdown {
    position: relative;
    width: calc(8ch + 0.625rem);
    font-size: 0.75rem;
  }

  .period-trigger {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0 0.3125rem 0.125rem;
    background: var(--bg);
    border-bottom: 1px solid var(--fg-tertiary);
    transition:
      color var(--theme-fade) ease,
      background-color var(--theme-fade) ease,
      border-color var(--theme-fade) ease;
  }

  .period-menu-viewport {
    position: absolute;
    z-index: 2;
    top: calc(100% - 1px);
    right: -1px;
    width: calc(100% + 2px);
    height: 6rem;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 0.34s;
  }

  .period-menu {
    background: var(--bg);
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 4px 4px;
    transform: translateY(-100%);
    transition:
      transform 0.34s cubic-bezier(0.22, 0.8, 0.25, 1),
      background-color var(--theme-fade) ease,
      border-color var(--theme-fade) ease;
  }

  .period-dropdown[data-open="true"] .period-menu-viewport {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .period-dropdown[data-open="true"] .period-menu {
    transform: translateY(0);
  }

  .period-menu button {
    display: block;
    width: 100%;
    padding: 0.25rem;
    text-align: left;
    white-space: nowrap;
    border-radius: 2px;
    transition:
      color var(--theme-fade) ease,
      background-color var(--theme-fade) ease;
  }

  .period-menu button:hover {
    background: var(--border);
  }

  .period-menu button[aria-current="true"] {
    color: var(--fg);
  }

  .artists-content {
    display: grid;
    min-height: 6.5rem;
    margin-top: 0.625rem;
  }

  ol {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem 2rem;
    list-style: none;
  }

  .top-artists :global(.artist-item) {
    min-width: 0;
  }

  .top-artists :global(.artist-name),
  .top-artists :global(.artist-count) {
    display: block;
  }

  .top-artists :global(.artist-count) {
    margin-top: 0.125rem;
    color: var(--fg-tertiary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .top-artists :global(.artist-plays) {
    display: inline-block;
    white-space: pre;
  }

  .artist-status {
    grid-area: 1 / 1;
    place-self: center;
    color: var(--fg-tertiary);
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .period-menu {
      transition: none;
    }
  }
</style>
