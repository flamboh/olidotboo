---
import * as stylex from "@stylexjs/stylex";

import { styles } from "@/styles/activity-heatmap.stylex";

interface Props {
  username: string;
  source: "github" | "lastfm";
  profileUrl: string;
  alt: string;
  streakLabel: "contribution" | "listening";
  spaced?: boolean;
}

const {
  username,
  source,
  profileUrl,
  alt,
  streakLabel,
  spaced = false,
} = Astro.props;
const encodedUsername = encodeURIComponent(username);
const endpoint = `https://heat.oli.boo/${source}/${encodedUsername}`;
const totalLabel = source === "github" ? "contributions" : "plays";
---

<div {...stylex.attrs(styles.source, spaced && styles.sourceSpaced)}>
  <h3 {...stylex.attrs(styles.sourceLabel)}>
    {source === "github" ? "github" : "last.fm"}
  </h3>
  <a
    {...stylex.attrs(styles.heatmap)}
    href={profileUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${username}'s ${source === "github" ? "GitHub" : "Last.fm"} profile`}
  >
    <img
      {...stylex.attrs(styles.imageFrame, styles.image)}
      src={`${endpoint}?display=minimal`}
      {alt}
      loading="lazy"
      width="686"
      height="88"
      data-activity-image
      data-theme-endpoint={`${endpoint}?display=minimal`}
      data-visible-class={stylex.attrs(styles.imageVisible).class}
      data-ghost-class={stylex.attrs(styles.imageFrame, styles.ghost).class}
      data-ghost-fading-class={stylex.attrs(styles.ghostFading).class}
    />
  </a>
  <p
    {...stylex.attrs(styles.summary)}
    data-activity-summary
    data-streak-endpoint={`${endpoint}/streak`}
    data-total-endpoint={`${endpoint}/total`}
    data-streak-label={streakLabel}
    data-total-label={totalLabel}
    data-visible-class={stylex.attrs(styles.summaryVisible).class}
    aria-live="polite"
    aria-atomic="true"
  >
  </p>
</div>

<script>
  import { applySvgTheme, type SvgTheme } from "@/lib/svg-theme";

  const pageRoot = document.documentElement;
  const svgResponses = new Map<string, Promise<string>>();
  // Both themed variants per image, built and decoded up front so a theme
  // switch is a lookup rather than a fetch, a blob and a decode.
  const themedUrls = new WeakMap<
    HTMLImageElement,
    Partial<Record<SvgTheme, string>>
  >();
  // Read from CSS so the cleanup timing follows --crossfade, including the
  // dev-only slow-motion override.
  const crossfadeDuration =
    parseFloat(getComputedStyle(pageRoot).getPropertyValue("--crossfade")) *
      1000 || 220;

  function addGeneratedClasses(element: Element, classNames?: string) {
    const classes = classNames?.split(/\s+/).filter(Boolean);
    if (classes && classes.length > 0) element.classList.add(...classes);
  }

  // The heatmap is an <img>, so a theme switch replaces the whole bitmap at
  // once. Fade the outgoing frame out over the incoming one to match the
  // page's own theme transition.
  function crossfade(image: HTMLImageElement, nextSrc: string) {
    const ghost = document.createElement("img");
    addGeneratedClasses(ghost, image.dataset.ghostClass);
    ghost.src = image.src;
    ghost.alt = "";
    ghost.setAttribute("aria-hidden", "true");
    image.parentElement?.appendChild(ghost);

    image.src = nextSrc;
    // Force the ghost's starting opacity to be computed; without this the
    // browser only ever sees the final value and skips the transition.
    void getComputedStyle(ghost).opacity;
    addGeneratedClasses(ghost, image.dataset.ghostFadingClass);
    ghost.dataset.fading = "true";
    setTimeout(() => ghost.remove(), crossfadeDuration + 60);
  }

  function getSvg(endpoint: string) {
    const cached = svgResponses.get(endpoint);
    if (cached) return cached;

    const request = fetch(endpoint).then((response) => {
      if (!response.ok) throw new Error("Unable to load activity SVG");
      return response.text();
    });
    svgResponses.set(endpoint, request);
    return request;
  }

  // Both variants are held for the life of the page, so the URLs are never
  // revoked — two small SVG blobs per heatmap.
  async function prepareThemes(image: HTMLImageElement, endpoint: string) {
    const svg = await getSvg(endpoint);
    const variants = themedUrls.get(image) ?? {};
    themedUrls.set(image, variants);

    await Promise.all(
      (["light", "dark"] as SvgTheme[]).map(async (variant) => {
        if (variants[variant]) return;
        variants[variant] = URL.createObjectURL(
          new Blob([applySvgTheme(svg, variant)], { type: "image/svg+xml" }),
        );
        // Decode now so the swap can't flash an empty frame later.
        const preload = new Image();
        preload.src = variants[variant];
        await preload.decode().catch(() => undefined);
      }),
    );
  }

  async function applyActivityImageTheme(
    image: HTMLImageElement,
    theme: SvgTheme,
  ) {
    const endpoint = image.dataset.themeEndpoint;
    if (!endpoint) return;

    try {
      if (!themedUrls.get(image)?.[theme]) await prepareThemes(image, endpoint);
      const next = themedUrls.get(image)?.[theme];
      if (!next || pageRoot.dataset.theme !== theme || image.src === next)
        return;

      const animate =
        image.dataset.visible === "true" &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (animate) {
        crossfade(image, next);
      } else {
        image.src = next;
      }
    } catch {
      // Keep the endpoint-rendered image as a fallback if fetching fails.
    }
  }

  function syncActivityImageThemes() {
    const theme = pageRoot.dataset.theme;
    if (theme !== "light" && theme !== "dark") return;

    document
      .querySelectorAll<HTMLImageElement>("[data-activity-image]")
      .forEach((image) => void applyActivityImageTheme(image, theme));
  }

  new MutationObserver(syncActivityImageThemes).observe(pageRoot, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
  syncActivityImageThemes();

  document
    .querySelectorAll<HTMLImageElement>("[data-activity-image]")
    .forEach((image) => {
      const reveal = () => {
        image.dataset.visible = "true";
        addGeneratedClasses(image, image.dataset.visibleClass);
      };
      if (image.complete && image.naturalWidth > 0) {
        reveal();
      } else {
        image.addEventListener("load", reveal, { once: true });
      }
    });

  document
    .querySelectorAll<HTMLElement>("[data-activity-summary]")
    .forEach(async (element) => {
      if (element.dataset.loaded === "true") return;
      element.dataset.loaded = "true";

      const streakEndpoint = element.dataset.streakEndpoint;
      const totalEndpoint = element.dataset.totalEndpoint;
      const streakLabel = element.dataset.streakLabel;
      const totalLabel = element.dataset.totalLabel;
      if (!streakEndpoint || !totalEndpoint || !streakLabel || !totalLabel)
        return;

      const streakText = fetch(streakEndpoint)
        .then(async (response) => {
          if (!response.ok) return null;
          const data: unknown = await response.json();
          if (
            typeof data !== "object" ||
            data === null ||
            !("streak" in data) ||
            typeof data.streak !== "number"
          )
            return null;

          const days = data.streak;
          return `${days.toLocaleString()} day${days === 1 ? "" : "s"} ${streakLabel} streak`;
        })
        .catch(() => null);

      const totalText = fetch(totalEndpoint)
        .then(async (response) => {
          if (!response.ok) return null;
          const data: unknown = await response.json();
          if (
            typeof data !== "object" ||
            data === null ||
            !("total" in data) ||
            typeof data.total !== "number"
          )
            return null;

          return `${data.total.toLocaleString()} ${totalLabel} in the last year`;
        })
        .catch(() => null);

      const parts = (await Promise.all([streakText, totalText])).filter(
        (part): part is string => part !== null,
      );
      if (parts.length > 0) {
        element.textContent = parts.join(" · ");
        element.dataset.visible = "true";
        addGeneratedClasses(element, element.dataset.visibleClass);
      }
    });
</script>
