---
import { Image } from "astro:assets";
import { design } from "@/data";
---

<section class="design" aria-labelledby="design-label" data-design>
  <h2 class="label" id="design-label">Design</h2>
  <div class="design-grid">
    {
      design.map((work) => (
        <article class="design-card" data-design-card>
          <button class="design-media" type="button" aria-expanded="false">
            <Image
              src={work.image}
              alt={work.description}
              widths={[480, 760, 1140, 1520]}
              sizes="(max-width: 640px) 100vw, 344px"
            />
            {work.video && (
              <video muted loop playsinline preload="none" aria-hidden="true">
                <source src={work.video.webm} type="video/webm" />
                <source src={work.video.mp4} type="video/mp4" />
              </video>
            )}
          </button>
          <div class="design-text">
            <h3>
              <a href={work.href} target="_blank" rel="noopener noreferrer">
                {work.title}
              </a>
            </h3>
            <p class="design-alt">{work.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-design]");

  if (root) {
    const grid = root.querySelector<HTMLElement>(".design-grid");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-design-card]")];
    const reducedMotion = matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const moveDuration = 520;
    const moveEasing = "cubic-bezier(0.65, 0, 0.35, 1)";
    let moveToken = 0;

    const mediaOf = (card: Element) =>
      card.querySelector<HTMLElement>(".design-media")!;
    const textOf = (card: Element) =>
      card.querySelector<HTMLElement>(".design-text")!;
    const descriptionOf = (card: Element) =>
      card.querySelector<HTMLElement>(".design-alt")!;
    const imageOf = (card: Element) => card.querySelector("img")!;

    function transformBetween(from: DOMRect, to: DOMRect, scale: boolean) {
      const dx = from.left - to.left;
      const dy = from.top - to.top;
      if (!scale) return `translate(${dx}px, ${dy}px)`;
      return `translate(${dx}px, ${dy}px) scale(${from.width / to.width}, ${from.height / to.height})`;
    }

    function syncSizes() {
      cards.forEach((card) => {
        const width = Math.ceil(imageOf(card).getBoundingClientRect().width);
        if (width > 0) imageOf(card).sizes = `${width}px`;
      });
    }

    function flip(mutate: () => void) {
      const first = new Map(
        cards.flatMap((card) => [
          [mediaOf(card), mediaOf(card).getBoundingClientRect()] as const,
          [textOf(card), textOf(card).getBoundingClientRect()] as const,
        ]),
      );
      const startHeight = root!.getBoundingClientRect().height;
      root!
        .getAnimations({ subtree: true })
        .forEach((animation) => animation.cancel());
      const startGridHeight = grid!.getBoundingClientRect().height;
      root!.style.height = `${startHeight}px`;

      mutate();
      syncSizes();
      const endHeight =
        startHeight + grid!.getBoundingClientRect().height - startGridHeight;
      if (!reducedMotion && startHeight !== endHeight) {
        root!.animate(
          [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
          { duration: moveDuration, easing: moveEasing },
        );
      }
      root!.style.removeProperty("height");
      if (reducedMotion) return;

      first.forEach((from, element) => {
        const to = element.getBoundingClientRect();
        const resized = Math.abs(from.width - to.width) > 1;
        const moved =
          Math.abs(from.left - to.left) > 0.5 ||
          Math.abs(from.top - to.top) > 0.5;
        if (!moved && !resized) return;
        if (element.classList.contains("design-media")) {
          element.animate(
            [
              {
                transformOrigin: "0 0",
                transform: transformBetween(from, to, true),
              },
              { transformOrigin: "0 0", transform: "none" },
            ],
            { duration: moveDuration, easing: moveEasing },
          );
        } else if (resized) {
          element.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: moveDuration / 2,
            delay: moveDuration / 2,
            easing: "ease",
            fill: "backwards",
          });
        } else {
          element.animate(
            [{ transform: transformBetween(from, to, false) }, {}],
            { duration: moveDuration, easing: moveEasing },
          );
        }
      });

      const token = ++moveToken;
      root!.dataset.moving = "";
      Promise.all(
        root!
          .getAnimations({ subtree: true })
          .map((animation) => animation.finished.catch(() => {})),
      ).then(() => {
        if (token === moveToken) delete root!.dataset.moving;
      });
    }

    function setExpanded(card: HTMLElement, expand: boolean) {
      cards.forEach((other) => {
        const expanded = other === card && expand;
        other.toggleAttribute("data-raised", other === card);
        other.toggleAttribute("data-expanded", expanded);
        mediaOf(other).setAttribute("aria-expanded", String(expanded));
      });
    }

    function descriptionState(card: HTMLElement) {
      const description = descriptionOf(card);
      const style = getComputedStyle(description);
      if (style.display === "none") {
        return { height: 0, marginTop: "0px", opacity: "0" };
      }
      return {
        height: description.getBoundingClientRect().height,
        marginTop: style.marginTop,
        opacity: style.opacity,
      };
    }

    function revealDescription(
      card: HTMLElement,
      show: boolean,
      from: ReturnType<typeof descriptionState>,
    ) {
      const description = descriptionOf(card);
      description.getAnimations().forEach((animation) => animation.cancel());
      card.toggleAttribute("data-collapsing", !show);
      const to = show
        ? descriptionState(card)
        : { height: 0, marginTop: "0px", opacity: "0" };
      description
        .animate(
          [
            {
              height: `${from.height}px`,
              marginTop: from.marginTop,
              overflow: "clip",
            },
            {
              height: `${to.height}px`,
              marginTop: to.marginTop,
              overflow: "clip",
            },
          ],
          { duration: moveDuration, easing: moveEasing },
        )
        .finished.then(() => card.removeAttribute("data-collapsing"))
        .catch(() => {});
      description.animate(
        [{ opacity: from.opacity }, { opacity: to.opacity }],
        {
          duration: moveDuration,
          easing: "ease",
        },
      );
    }

    function expandCard(card: HTMLElement) {
      const expand = !card.hasAttribute("data-expanded");
      const singleColumn =
        getComputedStyle(grid!).gridTemplateColumns.split(" ").length === 1;
      if (!singleColumn) {
        flip(() => setExpanded(card, expand));
        return;
      }
      const previous = cards.find(
        (other) => other !== card && other.hasAttribute("data-expanded"),
      );
      const before = new Map(
        cards.map((other) => [other, descriptionState(other)] as const),
      );
      setExpanded(card, expand);
      if (reducedMotion) return;
      revealDescription(card, expand, before.get(card)!);
      if (previous) revealDescription(previous, false, before.get(previous)!);
    }

    root.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const media = event.target.closest(".design-media");
      const card = media?.closest<HTMLElement>("[data-design-card]");
      if (card) expandCard(card);
    });

    root.querySelectorAll("img").forEach((image) => {
      const reveal = () => (image.dataset.loaded = "");
      if (image.complete && image.naturalWidth > 0) reveal();
      else image.addEventListener("load", reveal, { once: true });
    });

    if (!reducedMotion) {
      const videos = root.querySelectorAll("video");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          const video = target as HTMLVideoElement;
          if (isIntersecting) video.play().catch(() => {});
          else video.pause();
        });
      });
      videos.forEach((video) => {
        video.addEventListener("playing", () => {
          video.dataset.playing = "";
        });
        observer.observe(video);
      });
    }

    syncSizes();
  }
</script>

<style>
  .design {
    margin-top: 2.5rem;
  }

  .design-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1.75rem 2rem;
    padding-top: 1.125rem;
  }

  .design-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .design-card[data-raised] {
    z-index: 1;
  }

  .design-card[data-expanded] {
    grid-column: 1 / -1;
  }

  .design-media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 4px;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition:
      border-color var(--theme-fade) ease,
      outline-color 0.15s ease;
  }

  .design-media:hover,
  .design-media:focus-visible {
    outline-color: var(--accent);
  }

  @media (hover: none) {
    .design-media:hover {
      outline-color: transparent;
    }

    .design-card[data-expanded] .design-media {
      outline-color: var(--accent);
    }
  }

  .design[data-moving] .design-media {
    outline-color: transparent;
  }

  .design-media img,
  .design-media video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .design-media img {
    color: transparent;
  }

  @media (scripting: enabled) {
    .design-media img {
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .design-media img[data-loaded] {
      opacity: 1;
    }
  }

  .design-media video {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .design-media video[data-playing] {
    opacity: 1;
  }

  .design h3 {
    font-family: var(--heading-font-family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: normal;
  }

  .design h3 a {
    text-decoration: none;
  }

  .design-alt {
    display: none;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  [data-expanded] .design-alt,
  [data-collapsing] .design-alt {
    display: block;
  }

  @media (max-width: 640px) {
    .design-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
