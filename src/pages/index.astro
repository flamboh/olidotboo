---
import * as stylex from "@stylexjs/stylex";

import GithubGraph from "@/components/GithubGraph.astro";
import LastfmHeatmap from "@/components/LastfmHeatmap.astro";
import TopArtists from "@/components/TopArtists.astro";
import { email, experience, projects, socials } from "@/data";
import "../styles/global.css";
import { darkTheme, lightTheme } from "../styles/theme.stylex";
import { styles } from "../styles/page.stylex";

const sections = [
  { id: "experience", label: "what i do", entries: experience },
  { id: "projects", label: "things i made", entries: projects },
];

const lightThemeClass =
  stylex.attrs(lightTheme, styles.lightScheme).class ?? "";
const darkThemeClass = stylex.attrs(darkTheme, styles.darkScheme).class ?? "";
const isDev = import.meta.env.DEV;
---

<html
  lang="en"
  {...stylex.attrs(lightTheme, styles.lightScheme)}
  data-theme="light"
  data-light-theme-class={lightThemeClass}
  data-dark-theme-class={darkThemeClass}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="oliver boorstein — researcher, music lover, cs + data science @ uoregon"
    />
    <title>oliboo</title>
    {isDev && <link rel="stylesheet" href="/virtual:stylex.css" />}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem("theme");
        const theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        function applyTheme(next) {
          root.dataset.theme = next;
          const themeClasses = [
            root.dataset.lightThemeClass,
            root.dataset.darkThemeClass,
          ]
            .flatMap((value) => value?.split(/\s+/) ?? [])
            .filter(Boolean);
          const nextClasses = (
            next === "dark"
              ? root.dataset.darkThemeClass
              : root.dataset.lightThemeClass
          )
            ?.split(/\s+/)
            .filter(Boolean);

          root.classList.remove(...themeClasses);
          root.classList.add(...(nextClasses ?? []));
        }

        applyTheme(theme);
      })();
    </script>
  </head>
  <body {...stylex.attrs(styles.body)}>
    <main {...stylex.attrs(styles.main)}>
      <header {...stylex.attrs(styles.masthead, styles.enter)}>
        <div>
          <h1 {...stylex.attrs(styles.heading)}>
            oliver boorstein <span {...stylex.attrs(styles.pronouns)}
              >he/they</span
            >
          </h1>
          <p {...stylex.attrs(styles.tagline)}>
            researcher, full-stack dev & track listener — cs + data science @
            uoregon
          </p>
          <button
            {...stylex.attrs(
              styles.button,
              styles.contactLine,
              styles.focusable,
            )}
            type="button"
            data-copy-email
            data-email={email}
          >
            contact me: {email}
          </button>
        </div>
        <button
          {...stylex.attrs(styles.button, styles.focusable)}
          type="button"
          data-theme-toggle
          aria-label="switch theme"
        >
          [dark]
        </button>
      </header>

      <div
        {...stylex.attrs(styles.contentGrid, styles.enter, styles.enterContent)}
      >
        {
          sections.map((section) => (
            <section
              {...stylex.attrs(styles.contentColumn)}
              data-section={section.id}
              aria-labelledby={`${section.id}-label`}
            >
              <h2 {...stylex.attrs(styles.label)} id={`${section.id}-label`}>
                {section.label}
              </h2>
              <div {...stylex.attrs(styles.rows)}>
                {section.entries.map((entry) => (
                  <article>
                    <h3 {...stylex.attrs(styles.subheading)}>
                      {entry.href ? (
                        <a
                          {...stylex.attrs(styles.link, styles.focusable)}
                          href={entry.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {entry.title}
                        </a>
                      ) : (
                        entry.title
                      )}
                      {entry.subtitle && (
                        <span
                          {...stylex.attrs(
                            styles.subtitle,
                            section.id === "experience" &&
                              styles.experienceSubtitle,
                          )}
                        >
                          {entry.subtitle}
                        </span>
                      )}
                    </h3>
                    <p {...stylex.attrs(styles.description)}>
                      {entry.description}
                    </p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <section
        {...stylex.attrs(styles.activity, styles.enter, styles.enterActivity)}
        aria-labelledby="activity-label"
      >
        <h2 {...stylex.attrs(styles.label)} id="activity-label">streaks</h2>
        <GithubGraph />
        <LastfmHeatmap />
        <TopArtists />
      </section>

      <footer
        {...stylex.attrs(styles.footer, styles.enter, styles.enterFooter)}
      >
        {
          socials.map((social) => (
            <a
              {...stylex.attrs(
                styles.link,
                styles.footerLink,
                styles.focusable,
              )}
              href={social.href}
              target={social.href.startsWith("/") ? undefined : "_blank"}
              rel="noopener noreferrer"
            >
              {social.label}
            </a>
          ))
        }
      </footer>
    </main>

    <script>
      if (import.meta.env.DEV) {
        void import("virtual:stylex:runtime");
      }

      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );

      function applyTheme(next: "light" | "dark") {
        root.dataset.theme = next;
        const themeClasses = [
          root.dataset.lightThemeClass,
          root.dataset.darkThemeClass,
        ]
          .flatMap((value) => value?.split(/\s+/) ?? [])
          .filter(Boolean);
        const nextClasses = (
          next === "dark"
            ? root.dataset.darkThemeClass
            : root.dataset.lightThemeClass
        )
          ?.split(/\s+/)
          .filter(Boolean);

        root.classList.remove(...themeClasses);
        root.classList.add(...(nextClasses ?? []));
      }

      function syncToggle() {
        if (!toggle) return;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        toggle.textContent = `[${next}]`;
        toggle.setAttribute("aria-label", `switch to ${next} theme`);
      }

      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(next);
        localStorage.setItem("theme", next);
        syncToggle();
      });
      syncToggle();

      const copyButton =
        document.querySelector<HTMLButtonElement>("[data-copy-email]");
      const copyLabel = copyButton?.textContent ?? "";
      copyButton?.addEventListener("click", async () => {
        const address = copyButton.dataset.email ?? "";
        try {
          await navigator.clipboard.writeText(address);
          copyButton.textContent = "copied!";
        } catch {
          copyButton.textContent = "copy failed";
        }
        setTimeout(() => (copyButton.textContent = copyLabel), 1600);
      });
    </script>
  </body>
</html>
